---
import "../styles/footer.css";

import logo from "../assets/footer/logo.svg";
import servicesIcon from "../assets/footer/services-a-la-personne.webp";
import { Image } from "astro:assets";
import { site } from "../lib/site-data";

const navigation = [
  { label: "Accueil", href: "/" },
  { label: "Comment ça marche ?", href: "/#comment-ca-marche" },
  { label: "Formules", href: "/formules/" },
  { label: "Crédit d'impôt", href: "/avanceimmediate/" },
  { label: "À propos", href: "/a-propos/" },
  { label: "FAQ", href: "/faq/" },
  { label: "Journal", href: "/journal/" },
  { label: "Zone d'intervention", href: "/zone-intervention/" },
];

const conditions = [
  { label: "Mentions légales", href: "/mentions-legales/" },
  { label: "CGV", href: "/cgv/" },
  { label: "Politique de confidentialité", href: "/politique-de-confidentialite/" },
];

const annee = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__top">
    <img src={logo.src} width={logo.width} height={logo.height} alt="Le Cuistologue" class="footer__logo" />

    <div class="footer__brand">
      <p class="footer__tagline">Le goût du lien</p>
      <p class="footer__description">
        Cuisinier à domicile dans l'Oise, le Val-d'Oise, les Yvelines et l'Eure. Une cuisine maison, sur-mesure, préparée chez vous en une seule session.
      </p>
      {site.social.length > 0 && (
        <div class="footer__social">
          {site.social.map((reseau) => (
            <a href={reseau.url} aria-label={reseau.label} target="_blank" rel="noopener noreferrer">
              {reseau.label}
            </a>
          ))}
        </div>
      )}
      {/* Réseaux masqués tant que site.social est vide. */}
    </div>

    <nav class="footer__col footer__col--nav">
      <h3 class="footer__col-title">Navigation</h3>
      <ul>
        {navigation.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav class="footer__col footer__col--conditions">
      <h3 class="footer__col-title">Conditions</h3>
      <ul>
        {conditions.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
        <li><a href="#" id="footer-gerer-cookies">Gérer mes cookies</a></li>
      </ul>
    </nav>

    <div class="footer__col footer__col--contact">
      <h3 class="footer__col-title">Contact</h3>
      <ul>
        <li><a href={site.phone.href}>{site.phone.display}</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
      <p class="footer__address">
        Basé dans l'Oise (60)
      </p>
      <p class="footer__zone">
        Zone d'intervention<br />
        {site.areas.map((a, i) => (
          <>
            {i > 0 && " · "}<a href={`/cuisinier-a-domicile-${a.slug}/`}>{a.name}</a>
          </>
        ))}
      </p>
      <a href="https://www.servicesalapersonne.gouv.fr/" target="_blank" rel="noopener noreferrer">
        <Image src={servicesIcon} alt="Services à la personne" class="footer__services-icon" />
      </a>
    </div>
  </div>

  <div class="footer__bottom">
    <p>© {annee} Le Cuistologue. Tous droits réservés.</p>
    <p>Fait avec ❤️ par Antoine Bruneau</p>
  </div>
</footer>
