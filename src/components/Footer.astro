---
import "../styles/footer.css";

import logo from "../assets/footer/logo.svg";
import instagram from "../assets/footer/instagram.svg";
import facebook from "../assets/footer/facebook.svg";
import servicesIcon from "../assets/footer/services-a-la-personne.png";
import { Image } from "astro:assets";

const navigation = [
  { label: "Accueil", href: "/" },
  { label: "Comment ça marche ?", href: "/#comment-ca-marche" },
  { label: "Formules", href: "/formules" },
  { label: "À propos", href: "/a-propos" },
  { label: "Avance immédiate", href: "/avance-immediate" },
  { label: "FAQ", href: "/faq" },
];

const conditions = [
  { label: "Mentions légales", href: "/mentions-legales" },
  { label: "CGV", href: "/cgv" },
  { label: "Politique de confidentialité", href: "/politique-de-confidentialite" },
];

const annee = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__top">
    <div class="footer__brand">
      <img src={logo.src} alt="Le Cuistologue" class="footer__logo" />
      <h2 class="footer__tagline">Le goût du lien</h2>
      <p class="footer__description">
        Des repas préparés directement chez vous, par un professionnel, pour retrouver le plaisir de bien manger sans passer vos soirées en cuisine.
      </p>
      <div class="footer__social">
        <a href="https://instagram.com" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
          <img src={instagram.src} alt="" aria-hidden="true" />
        </a>
        <a href="https://facebook.com" aria-label="Facebook" target="_blank" rel="noopener noreferrer">
          <img src={facebook.src} alt="" aria-hidden="true" />
        </a>
      </div>
    </div>

    <nav class="footer__col">
      <h3 class="footer__col-title">Navigation</h3>
      <ul>
        {navigation.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav class="footer__col">
      <h3 class="footer__col-title">Conditions</h3>
      <ul>
        {conditions.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
        <li><a href="#" id="footer-gerer-cookies">Gérer mes cookies</a></li>
      </ul>
    </nav>

    <div class="footer__col">
      <h3 class="footer__col-title">Contact</h3>
      <ul>
        <li><a href="tel:0612776264">06 12 77 62 64</a></li>
        <li><a href="mailto:contact@lecuistologue.fr">contact@lecuistologue.fr</a></li>
      </ul>
      <p class="footer__zone">
        Zone d'intervention<br />
        Oise · Val-d'Oise · Yvelines
      </p>
      <Image src={servicesIcon} alt="Services à la personne" class="footer__services-icon" />
    </div>
  </div>

  <div class="footer__bottom">
    <p>© {annee} Le Cuistologue. Tous droits réservés.</p>
    <p>Fait avec ❤️ par Antoine Bruneau</p>
  </div>
</footer>