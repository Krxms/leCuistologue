---
import "../../../styles/sections/faq/faq-accordion.css";
import { questions, answerToHtml } from "../../../lib/faq-data";
---

<section class="faq-accordion">
  <div class="faq-accordion__header">
    <h2 class="faq-accordion__title">Les réponses aux questions les plus fréquentes.</h2>
    <p class="faq-accordion__subtitle">Et si vous ne trouvez pas l'information recherchée, <a href="/contact/">contactez-moi</a>.</p>
  </div>

  <div class="faq-accordion__grid">
    {questions.map((item) => (
      <details class="faq-accordion__item" name="faq">
        <summary class="faq-accordion__question">
          <span class="faq-accordion__question-text">{item.q}</span>
          <span class="faq-accordion__icon" aria-hidden="true"></span>
        </summary>
        <div class="faq-accordion__answer">
          {item.r.split("\n\n").map((paragraphe) => (
            <p set:html={answerToHtml(paragraphe)} />
          ))}
        </div>
      </details>
    ))}
  </div>
</section>
