---
import "../../../styles/sections/faq/faq-header.css";
import { Image } from "astro:assets";

import bg from "../../../assets/faq/header/bg.svg";
// import broccoli from "../../../assets/faq/header/brocoli.svg";  // SVG conservé — perf images, repasser ici si besoin
import broccoli from "../../../assets/faq/header/brocoli.webp";
// import mushroom from "../../../assets/faq/header/mushroom.svg";  // SVG conservé — perf images, repasser ici si besoin
import mushroom from "../../../assets/faq/header/mushroom.webp";
// import chicken from "../../../assets/faq/header/chicken.svg";  // SVG conservé — perf images, repasser ici si besoin
import chicken from "../../../assets/faq/header/chicken.webp";
// import onion from "../../../assets/faq/header/onion.svg";  // SVG conservé — perf images, repasser ici si besoin
import onion from "../../../assets/faq/header/onion.webp";
import arrowConnector from "../../../assets/faq/header/arrow-connector.svg";
---

<section class="faq-header">
  <img src={bg.src} alt="" class="faq-header__bg" aria-hidden="true" />

  <Image src={broccoli} alt="" class="faq-header__deco faq-header__deco--broccoli" aria-hidden="true" />
  <Image src={mushroom} alt="" class="faq-header__deco faq-header__deco--mushroom" aria-hidden="true" />
  <Image src={chicken} alt="" class="faq-header__deco faq-header__deco--chicken" aria-hidden="true" />
  <Image src={onion} alt="" class="faq-header__deco faq-header__deco--onion" aria-hidden="true" />

  <h1 class="faq-header__title">
    <span class="faq-header__title-base">Vous</span> <span class="faq-header__title-accent">avez</span><br>
    <span class="faq-header__title-base">une</span> <span class="faq-header__title-accent">question ?<img src={arrowConnector.src} alt="" class="faq-header__arrow" aria-hidden="true" /></span>
  </h1>
</section>