---
---

<section class="relative overflow-hidden bg-peach">
  <div class="mx-auto grid max-w-7xl gap-10 px-6 py-20 md:grid-cols-2 md:items-center md:py-28">
    <div class="reveal">
      <h1 class="font-display text-4xl font-semibold uppercase leading-[1.08] text-ink md:text-5xl">
        Une cuisine maison qui simplifie vraiment votre quotidien
      </h1>
      <p class="mt-6 max-w-md text-base leading-relaxed text-ink-soft">
        Des repas préparés directement chez vous, à partir de produits de
        saison, pour retrouver le plaisir de bien manger sans passer des
        heures en cuisine.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="/formules"
          class="rounded-full bg-forest px-6 py-3 text-sm font-semibold text-cream transition-transform hover:scale-[1.03]"
        >
          Découvrir les formules
        </a>
        <a
          href="/contact"
          class="rounded-full border border-forest/30 px-6 py-3 text-sm font-semibold text-forest transition-colors hover:bg-forest/5"
        >
          Demander un devis
        </a>
      </div>
    </div>

    <div class="reveal aspect-[4/3] w-full overflow-hidden rounded-[2.5rem] photo-placeholder" style="transition-delay:120ms">
      <svg width="72" height="72" viewBox="0 0 24 24" fill="none" class="text-forest/40" aria-hidden="true">
        <path
          d="M4 21c0-5 3-8 8-8s8 3 8 8M9 3l1 6M15 3l-1 6M6 9h12"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </div>
  </div>

  <div class="flex justify-center pb-6 text-forest/50">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </div>
</section>
