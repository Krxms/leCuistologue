---
import "../../../styles/sections/zone/zone.css";
import { site } from "../../../lib/site-data";

interface Props {
  area: (typeof site.areas)[number];
}
const { area } = Astro.props;
const autres = site.areas.filter((a) => a.slug !== area.slug);
---

<section class="zone">
  <div class="zone__content">
    <nav class="zone__breadcrumb" aria-label="Fil d'Ariane">
      <a href="/">Accueil</a>
      <span aria-hidden="true">›</span>
      <a href="/zone-intervention/">Zone d'intervention</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">{area.name}</span>
    </nav>

    <h1 class="zone__title">Cuisinier à domicile dans {area.prep} ({area.code})</h1>

    <p class="zone__text">{area.intro}</p>

    <p class="zone__text">{area.contexte}</p>

    <p class="zone__text">
      {area.pitch}<br /><br />
      Le détail des <a href="/formules/">formules et tarifs</a> est sur la page dédiée, et chaque
      prestation éligible ouvre droit au <a href="/avanceimmediate/">crédit d'impôt services à la personne</a>.
    </p>

    <h2 class="zone__subtitle">Communes desservies dans {area.prep}</h2>
    <ul class="zone__chips">
      {area.communes.map((c) => (
        <li>{c}</li>
      ))}
    </ul>

    <p class="zone__note">
      {area.noteIntro} Indiquez-moi son nom en demandant un devis : je vous dirai si je peux
      intervenir chez vous, avant tout engagement. Vous pouvez aussi m'appeler au{" "}
      <a href={site.phone.href}>{site.phone.display}</a>.
    </p>

    <a href="/contact/" class="zone__cta">Demander un devis</a>

    <h2 class="zone__subtitle">Questions fréquentes dans {area.prep}</h2>
    <div class="zone__faq">
      {area.faq.map((item) => (
        <div class="zone__faq-item">
          <h3 class="zone__faq-question">{item.q}</h3>
          <p class="zone__text">{item.a}</p>
        </div>
      ))}
    </div>

    <h2 class="zone__subtitle">Les autres départements</h2>
    <ul class="zone__links">
      {autres.map((a) => (
        <li>
          <a href={`/cuisinier-a-domicile-${a.slug}/`}>
            {a.name} ({a.code})
            <span>Cuisinier à domicile dans {a.prep}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
