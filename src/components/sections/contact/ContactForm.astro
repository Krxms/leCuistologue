---
import "../../../styles/sections/contact/contact-form.css";
---

<section class="contact-form-section">
  <!-- Envoi via /api/send (Worker + Resend, voir worker/index.ts) : un mail au Cuistologue, un mail de confirmation au client. -->
  <form class="contact-form" id="contact-form">

    <p class="contact-form__requis">Les champs marqués d'un <span class="requis">*</span> sont obligatoires.</p>

    <div class="contact-form__field">
      <label for="nom">Nom complet <span class="requis">*</span></label>
      <input type="text" id="nom" name="nom" required autocomplete="name" />
    </div>

    <div class="contact-form__field">
      <label for="email">Adresse e-mail <span class="requis">*</span></label>
      <input type="email" id="email" name="email" required autocomplete="email" />
    </div>

    <p class="contact-form__note">Laissez-moi vos coordonnées, je reviens vers vous sous 24h ouvrées.</p>

    <div class="contact-form__field">
      <label for="telephone">Numéro de téléphone <span class="requis">*</span></label>
      <input type="tel" id="telephone" name="telephone" required autocomplete="tel" />
    </div>

    <div class="contact-form__field">
      <label for="sujet">Sujet <span class="requis">*</span></label>
      <input type="text" id="sujet" name="sujet" required />
    </div>

    <div class="contact-form__field">
      <label for="message">Votre message <span class="requis">*</span></label>
      <textarea id="message" name="message" rows="6" required></textarea>
    </div>

    <button type="submit" class="contact-form__submit">Envoyer le message</button>

    <p class="contact-form__status" id="contact-form-status" role="status" aria-live="polite"></p>
  </form>
</section>

<script>
  import { activerValidationFormulaire } from "../../../scripts/form-validation";

  const form = document.getElementById("contact-form") as HTMLFormElement;
  const statusEl = document.getElementById("contact-form-status");

  if (form) activerValidationFormulaire(form, ".contact-form__field", statusEl);

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const boutonEnvoyer = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    boutonEnvoyer.disabled = true;
    if (statusEl) statusEl.textContent = "Envoi en cours...";

    const formData = new FormData(form);
    const data = {
      type: "contact",
      nom: formData.get("nom"),
      email: formData.get("email"),
      telephone: formData.get("telephone"),
      sujet: formData.get("sujet"),
      message: formData.get("message"),
    };

    try {
      const res = await fetch("/api/send", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });
      const resultat = await res.json() as { ok: boolean; erreur?: string };

      if (resultat.ok) {
        if (statusEl) statusEl.textContent = "Votre message a bien été envoyé. Vous recevrez une confirmation par e-mail.";
        form.reset();
      } else {
        if (statusEl) statusEl.textContent = "Une erreur est survenue. Réessayez ou contactez-nous directement par téléphone.";
        boutonEnvoyer.disabled = false;
      }
    } catch {
      if (statusEl) statusEl.textContent = "Une erreur réseau est survenue. Réessayez.";
      boutonEnvoyer.disabled = false;
    }
  });
</script>