---
const valeurs = [
  {
    titre: "Une cuisine artisanale",
    texte: "Le savoir-faire d'un professionnel, directement dans votre cuisine.",
  },
  {
    titre: "Pour votre quotidien",
    texte: "Chaque intervention s'adapte à vos habitudes et à l'organisation de votre foyer.",
  },
  {
    titre: "Agriculture paysanne",
    texte: "Des produits de saison, choisis autant que possible auprès des producteurs engagés du territoire.",
  },
  {
    titre: "Le goût du lien",
    texte: "Le plaisir de cuisiner des repas qui nourrissent aussi les échanges.",
  },
];
---

<section class="bg-sage">
  <div class="mx-auto max-w-7xl px-6 py-16">
    <h2 class="reveal text-center font-display text-2xl font-semibold text-forest md:text-3xl">
      Une cuisine <span class="font-accent text-forest-light">qui a du sens</span>
    </h2>

    <div class="mt-12 grid gap-6 md:grid-cols-4">
      {
        valeurs.map((valeur, i) => (
          <div
            class="reveal rounded-[2rem] bg-cream/90 p-6 text-center shadow-sm"
            style={`transition-delay:${i * 90}ms`}
          >
            <p class="font-display font-semibold text-forest">{valeur.titre}</p>
            <p class="mt-2 text-sm leading-relaxed text-ink-soft">{valeur.texte}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
