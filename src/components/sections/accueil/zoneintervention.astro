---
import "../../../styles/sections/accueil/zone-intervention.css";
import { areaNames } from "../../../lib/site-data";

const zones = areaNames;
---

<section class="zone-intervention">
  <svg class="zone-intervention__shape" viewBox="0 0 100 100" preserveAspectRatio="none">
    <defs>
      <linearGradient id="zone-intervention-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#fbd9db" />
        <stop offset="100%" stop-color="#f8c9d4" />
      </linearGradient>
    </defs>
    <path
      d="M 0,8 Q 50,2 100,0 L 100,100 L 0,100 Z"
      fill="url(#zone-intervention-gradient)"
    />
  </svg>

  <div class="zone-intervention__content">
    <h2 class="zone-intervention__title">Une cuisine à domicile, près de chez vous</h2>
    <p class="zone-intervention__text">
      Le Cuistologue se déplace directement chez vous pour préparer vos repas, sur l'Oise, le
      Val-d'Oise, les Yvelines et l'Eure.
    </p>

    <ul class="zone-intervention__list">
      {zones.map((zone) => (
        <li>{zone}</li>
      ))}
    </ul>

    <p class="zone-intervention__note">
      Vous êtes en dehors de cette zone ? <a href="/contact">Contactez-moi</a>
    </p>

    <a href="/zone-intervention" class="zone-intervention__link">Voir la zone d'intervention</a>
  </div>
</section>
