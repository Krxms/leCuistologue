---
import "../../../styles/sections/accueil/valeurs-section.css";

// import bgBanner from "../../../assets/accueil/valeurs/bandeauValeurs.png";  // source conservée — perf images
import bgBanner from "../../../assets/accueil/valeurs/bandeauValeurs.webp";
import card1 from "../../../assets/accueil/valeurs/card-1.svg";
import card2 from "../../../assets/accueil/valeurs/card-2.svg";
import card3 from "../../../assets/accueil/valeurs/card-3.svg";
import card4 from "../../../assets/accueil/valeurs/card-4.svg";
// import poivrons from "../../../assets/accueil/valeurs/poivrons.svg";  // SVG conservé — perf images, repasser ici si besoin
import poivrons from "../../../assets/accueil/valeurs/poivrons.webp";

import { getAccueil } from "../../../lib/contenu";

// Titres et textes : éditables dans WordPress (page Accueil, voir lib/contenu.ts). Fonds et cadrages : mise en page, fixes.
const { valeurs: contenu } = (await getAccueil());
const cadres = [
  { bg: card1.src, ratio: "384 / 232", flip: false },
  { bg: card2.src, ratio: "382 / 232", flip: true },
  { bg: card3.src, ratio: "391 / 232", flip: false },
  { bg: card4.src, ratio: "415 / 232", flip: true },
];
const valeurs = contenu.bulles.map((bulle, i) => ({ ...bulle, ...cadres[i] }));
---

<section class="valeurs">
  <img src={bgBanner.src} alt="" class="valeurs__bg" aria-hidden="true" />
  <img src={poivrons.src} alt="" class="valeurs__decor valeurs__decor--poivrons" aria-hidden="true" />

  <div class="valeurs__content">
    <h2 class="valeurs__title">
      {contenu.titre} <span class="valeurs__title-accent">{contenu.titreAccent}</span>
    </h2>

    <div class="valeurs__grid">
      {
        valeurs.map((valeur) => (
          <div
            class="valeurs__card"
            style={`--card-bg:url(${valeur.bg}); aspect-ratio:${valeur.ratio};`}
          >
            <div class:list={["valeurs__card-inner", { "valeurs__card-inner--flip": valeur.flip }]}>
              <p class="valeurs__card-title">{valeur.titre}</p>
              <p class="valeurs__card-text">{valeur.texte}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>