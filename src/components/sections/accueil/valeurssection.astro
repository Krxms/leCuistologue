---
import "../../../styles/sections/accueil/valeurs-section.css";

import bgBanner from "../../../assets/accueil/valeurs/bandeauValeurs.svg";
import card1 from "../../../assets/accueil/valeurs/card-1.svg";
import card2 from "../../../assets/accueil/valeurs/card-2.svg";
import card3 from "../../../assets/accueil/valeurs/card-3.svg";
import card4 from "../../../assets/accueil/valeurs/card-4.svg";

const valeurs = [
  { titre: "Une cuisine artisanale", texte: "Le savoir-faire d'un professionnel, directement dans votre cuisine.", bg: card1.src, ratio: "384 / 232", flip: false },
  { titre: "Une approche sur-mesure", texte: "Chaque intervention s'adapte à vos habitudes, vos envies et à l'organisation de votre foyer.", bg: card2.src, ratio: "382 / 232", flip: true },
  { titre: "Agriculture paysanne", texte: "Des produits de saison, choisis autant que possible auprès des producteurs engagés du territoire.", bg: card3.src, ratio: "391 / 232", flip: false },
  { titre: "Le goût du lien", texte: "Le plaisir de cuisiner des repas qui nourrissent aussi les échanges.", bg: card4.src, ratio: "415 / 232", flip: true },
];
---

<section class="valeurs">
  <img src={bgBanner.src} alt="" class="valeurs__bg" aria-hidden="true" />

  <div class="valeurs__content">
    <h2 class="valeurs__title">
      Une cuisine <span class="valeurs__title-accent">qui a du sens</span>
    </h2>

    <div class="valeurs__grid">
      {
        valeurs.map((valeur) => (
          <div
            class="valeurs__card"
            style={`--card-bg:url(${valeur.bg}); aspect-ratio:${valeur.ratio};`}
          >
            <div class:list={["valeurs__card-inner", { "valeurs__card-inner--flip": valeur.flip }]}>
              <p class="valeurs__card-title">{valeur.titre}</p>
              <p class="valeurs__card-text">{valeur.texte}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>