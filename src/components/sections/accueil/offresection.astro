---
import "../../../styles/sections/accueil/offre-section.css";

import bgPink from "../../../assets/accueil/service/serviceBG.png";
import photoMain from "../../../assets/accueil/service/serviceBigPics.png";
import photoSecondary from "../../../assets/accueil/service/serviceSmallPics.png";
import titleIcon from "../../../assets/accueil/service/titlewow.svg";
import checklistBg from "../../../assets/accueil/service/checklistBG.svg";
import checkmark from "../../../assets/accueil/service/checkmark.svg";
import arrow from "../../../assets/accueil/service/arrow.svg";
import serviceInfoBg from "../../../assets/accueil/service/serviceInfoBG.svg";
import bgPinkMobile from "../../../assets/accueil/service/serviceBGmobile.png";
import { Image } from "astro:assets";

const colonneGauche = [
  "Échange préalable sur vos habitudes et vos envies",
  "Menus personnalisés",
  "Courses réalisées pour vous",
  "Cuisine à domicile",
  "Organisation du réfrigérateur",
];

const colonneDroite = [
  "Remise au propre de la cuisine",
  "Conseils de conservation",
  "Organisation d’une routine culinaire",
  "Réserve gourmande",
  "Popotes à emporter",
];
---

<section class="offre">
  <!-- ===== Desktop / tablette (≥1211px) ===== -->
  <div class="offre__desktop">
    <img src={bgPink.src} alt="" class="offre__bg" aria-hidden="true" />

    <div class="offre__header">
      <div class="offre__title-row">
        <h2 class="offre__title">
          Des solutions culinaires pensées pour vous et avec vous.
        </h2>
        <img
          src={titleIcon.src}
          alt=""
          class="offre__title-icon"
          aria-hidden="true"
        />
      </div>
      <p class="offre__description">
        <b>Le Cuistologue prépare chez vous, en une seule session, vos repas de la semaine.</b><br />
        Choisissez votre formule selon votre appétit, vos habitudes et la quantité
        de repas que vous souhaitez déléguer.<br><br>
        Et offrez-vous la possibilité d’ajouter certains services pour aller plus loin dans l’organisation de votre quotidien.
      </p>
      <p class="offre__include-label">Chaque intervention peut inclure :</p>
    </div>

    <div class="offre__checklist-wrap">
      <img
        src={checklistBg.src}
        alt=""
        class="offre__checklist-bg"
        aria-hidden="true"
      />
      <div class="offre__checklist">
        <ul class="offre__checklist-col">
          {
            colonneGauche.map((item) => (
              <li>
                <img src={checkmark.src} alt="" aria-hidden="true" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
        <ul class="offre__checklist-col">
          {
            colonneDroite.map((item) => (
              <li>
                <img src={checkmark.src} alt="" aria-hidden="true" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <img src={arrow.src} alt="" class="offre__arrow" aria-hidden="true" />

    <div class="offre__price-block">
      <p class="offre__price">
        <span class="offre__price-label">A partir de</span>
        <span class="offre__price-value">74,50 €</span>
        <span class="offre__price-label">/ intervention</span>
      </p>
      <div class="offre__promo">
        <img
          src={serviceInfoBg.src}
          alt=""
          class="offre__promo-bg"
          aria-hidden="true"
        />
        <p class="offre__promo-text">
          Offre de lancement : <strong>-20%</strong> sur votre 1ère intervention
        </p>
      </div>
      <a href="/formules" class="offre__cta">Je découvre les formules !</a>
    </div>

    <Image
      src={photoMain}
      alt="Plats préparés par Le Cuistologue, prêts à emporter"
      class="offre__photo offre__photo--main"
    />
    <Image
      src={photoSecondary}
      alt=""
      class="offre__photo offre__photo--secondary"
      aria-hidden="true"
    />
  </div>

  <!-- ===== Mobile / tablette (≤1210px) ===== -->
  <div class="offre-m">
    <img src={bgPinkMobile.src} alt="" class="offre-m__bg" aria-hidden="true" />

    <div class="offre-m__title-row">
      <h2 class="offre-m__title">
        Des solutions culinaires pensées pour vous et avec vous.
      </h2>
      <img
        src={titleIcon.src}
        alt=""
        class="offre-m__title-icon"
        aria-hidden="true"
      />
    </div>
    <p class="offre-m__description">
      <b>Le Cuistologue prépare chez vous, en une seule session, vos repas de la semaine.</b><br /><br />
      Choisissez votre formule selon votre appétit, vos habitudes et la quantité
      de repas que vous souhaitez déléguer.<br><br>
      Et offrez-vous la possibilité d’ajouter certains services pour aller plus loin dans l’organisation de votre quotidien.
    </p>
    <p class="offre-m__include-label"><b>Chaque intervention peut inclure :</b></p>

    <div class="offre-m__checklist-wrap">
      <div class="offre-m__checklist">
        {
          [...colonneGauche, ...colonneDroite].map((item) => (
            <div class="offre-m__checklist-item">
              <img src={checkmark.src} alt="" aria-hidden="true" />
              <span>{item}</span>
            </div>
          ))
        }
      </div>
    </div>

    <img src={arrow.src} alt="" class="offre-m__arrow" aria-hidden="true" />

    <p class="offre-m__price">
      <span class="offre-m__price-label">A partir de</span>
      <span class="offre-m__price-value">74,50 €</span>
      <span class="offre-m__price-label">/ intervention</span>
    </p>
    <div class="offre-m__promo">
      <img
        src={serviceInfoBg.src}
        alt=""
        class="offre-m__promo-bg"
        aria-hidden="true"
      />
      <p class="offre-m__promo-text">
        Offre de lancement : <strong>-20%</strong> sur votre 1ère intervention
      </p>
    </div>
    <a href="/formules" class="offre-m__cta">Je découvre les formules !</a>

    <Image
      src={photoMain}
      alt="Plats préparés par Le Cuistologue, prêts à emporter"
      class="offre-m__photo"
    />
  </div>
</section>
