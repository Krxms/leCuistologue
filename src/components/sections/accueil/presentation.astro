---
import "../../../styles/sections/accueil/presentation.css";
import { Image } from "astro:assets";

import chefComposite from "../../../assets/accueil/presentation/def-chef.png";
import titleIcon from "../../../assets/accueil/presentation/def-titlewow.svg";
import bridgeArrow from "../../../assets/accueil/presentation/bridge-arrow.svg";

import brocoli from "../../../assets/accueil/presentation/brocoli.svg";
import oignon from "../../../assets/accueil/presentation/oignon.svg";
import aubergine from "../../../assets/accueil/presentation/aubergine.svg";
import champignons from "../../../assets/accueil/presentation/champignons.svg";
---

<section class="presentation">
  <img src={bridgeArrow.src} alt="" class="presentation__bridge-arrow" aria-hidden="true" />

  <img src={brocoli.src} alt="" class="presentation__decor presentation__decor--brocoli" aria-hidden="true" />
  <img src={oignon.src} alt="" class="presentation__decor presentation__decor--oignon" aria-hidden="true" />
  <img src={aubergine.src} alt="" class="presentation__decor presentation__decor--aubergine" aria-hidden="true" />
  <img src={champignons.src} alt="" class="presentation__decor presentation__decor--champignons" aria-hidden="true" />

  <div class="presentation__content">
    <img src={titleIcon.src} alt="" class="presentation__title-icon" aria-hidden="true" />
    <h2 class="presentation__title">Le Cuistologue</h2>
    <p class="presentation__phonetic"><em>[lə kɥis.tɔ.lɔɡ] n. m.</em> :</p>

    <div class="presentation__text">
      <p><strong>Nom donné à un cuisinier professionnel à domicile spécialiste de la cuisine du quotidien et du batch cooking.</strong></p>
      <p>Il prépare chez vous une cuisine sur-mesure, ajustée à vos goûts, vos contraintes et votre rythme de vie.</p>
      <p><em>Au-delà de la cuisine, il installe une routine alimentaire saine et durable, pensée pour les journées chargées.</em></p>
    </div>

    <a href="/a-propos" class="presentation__cta">Découvrir sa démarche</a>
  </div>

  <div class="presentation__photo-wrap">
    <Image src={chefComposite} alt="Le chef du Cuistologue en cuisine" class="presentation__photo" />
  </div>
</section>