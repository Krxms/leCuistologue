---
import "../../../styles/sections/accueil/presentation.css";
import { Image } from "astro:assets";

import chefComposite from "../../../assets/accueil/presentation/def-chef.webp";
import titleIcon from "../../../assets/accueil/presentation/def-titlewow.svg";
// import courgette from "../../../assets/accueil/presentation/courgette.svg";  // SVG conservé — perf images, repasser ici si besoin
import courgette from "../../../assets/accueil/presentation/courgette.webp";
// import oignon from "../../../assets/accueil/presentation/oignon.svg";  // SVG conservé — perf images, repasser ici si besoin
import oignon from "../../../assets/accueil/presentation/oignon.webp";
// import aubergine from "../../../assets/accueil/presentation/aubergine.svg";  // SVG conservé — perf images, repasser ici si besoin
import aubergine from "../../../assets/accueil/presentation/aubergine.webp";
// import champignons from "../../../assets/accueil/presentation/champignons.svg";  // SVG conservé — perf images, repasser ici si besoin
import champignons from "../../../assets/accueil/presentation/champignons.webp";
---

<section class="presentation">
  <img src={courgette.src} alt="" class="presentation__courgette" aria-hidden="true" />

  <div class="presentation__content">
    <img src={titleIcon.src} alt="" class="presentation__title-icon" aria-hidden="true" />
    <h2 class="presentation__title">Le Cuistologue</h2>
    <p class="presentation__phonetic"><em>[lə kɥis.tɔ.lɔɡ] n. m.</em> :</p>

    <div class="presentation__text">
      <p class="presentation__text-lead">Cuisinier professionnel à domicile spécialiste de la cuisine du quotidien.</p>
      <p>Il prépare chez vous une cuisine sur-mesure, ajustée à vos goûts, vos contraintes et votre rythme de vie.</p>
      <p><em>Au-delà de la cuisine, il installe une routine alimentaire durable, pensée pour bien manger, même pendant les journées chargées.</em></p>
    </div>

    <a href="/a-propos/" class="presentation__cta">Découvrir sa démarche</a>
  </div>

  <div class="presentation__photo-wrap">
    <Image src={chefComposite} alt="Le chef du Cuistologue en cuisine" class="presentation__photo" />
    <img src={oignon.src} alt="" class="presentation__photo-decor presentation__photo-decor--oignon" aria-hidden="true" />
    <img src={aubergine.src} alt="" class="presentation__photo-decor presentation__photo-decor--aubergine" aria-hidden="true" />
    <img src={champignons.src} alt="" class="presentation__photo-decor presentation__photo-decor--champignons" aria-hidden="true" />
    <img src={champignons.src} alt="" class="presentation__photo-decor presentation__photo-decor--champignons2" aria-hidden="true" />
  </div>
</section>