---
import "../../../styles/sections/accueil/comment-ca-marche.css";

import step1 from "../../../assets/accueil/howto/howto1.svg";
import step2 from "../../../assets/accueil/howto/howto2.svg";
import step3 from "../../../assets/accueil/howto/howto3.svg";
import connect1 from "../../../assets/accueil/howto/howto-connect1.svg";
import connect2 from "../../../assets/accueil/howto/howto-connect2.svg";

const etapes = [
  {
    numero: "1.",
    titre: ["On échange"],
    texte: "Vos habitudes guident chaque intervention.",
    image: step1,
    ratio: "380 / 322",
  },
  {
    numero: "2.",
    titre: ["Je cuisine chez vous"],
    texte: "Des repas maison préparés directement dans votre cuisine.",
    image: step2,
    ratio: "357 / 302",
  },
  {
    numero: "3.",
    titre: ["Vous profitez"],
    texte: "Des plats prêts, un frigo organisé et une cuisine impeccable.",
    image: step3,
    ratio: "375 / 277",
  },
];
---

<section id="comment-ca-marche" class="howto">
  <div class="howto__title-block reveal">
    <h2 class="howto__title">
      <span class="howto__title-line">Comment</span>
      <span class="howto__title-line howto__title-line--accent">ça marche ?</span>
    </h2>
    <p class="howto__subtitle">Une semaine qui se prépare en trois étapes</p>
  </div>

  <div class="howto__steps">
    {
      etapes.map((etape, i) => (
        <>
          <div class="howto__step reveal">
            <img
              src={etape.image.src}
              alt=""
              class="howto__step-illustration"
              style={`aspect-ratio:${etape.ratio}`}
              aria-hidden="true"
            />
            <div class="howto__step-heading">
              <span class="howto__step-number">{etape.numero}</span>
              <p class="howto__step-title">
                {etape.titre.map((ligne) => (
                  <>
                    {ligne}
                    <br />
                  </>
                ))}
              </p>
            </div>
            <p class="howto__step-text">{etape.texte}</p>
          </div>

          {i < etapes.length - 1 && (
            <img
              src={(i === 0 ? connect1 : connect2).src}
              alt=""
              class="howto__connector"
              aria-hidden="true"
            />
          )}
        </>
      ))
    }
  </div>
</section>