---
import "../../../styles/sections/accueil/hero.css";

import heroBackground from "../../../assets/accueil/hero/HeroBG.png";
import heroArrow from "../../../assets/accueil/hero/hero-arrow.svg";
import brocoli from "../../../assets/accueil/presentation/brocoli.svg";
import potato from "../../../assets/accueil/presentation/PdT.svg";

import { Image } from "astro:assets";
---

<section class="hero">
  <div class="hero__bg-wrapper">
  <Image src={heroBackground} alt="" class="hero__background" aria-hidden="true" />
</div>

  <img src={brocoli.src} alt="" class="hero__decor hero__decor--brocoli" aria-hidden="true" />
  <img src={potato.src} alt="" class="hero__decor hero__decor--potato" aria-hidden="true" />

  <div class="hero__content">
    <h1 class="hero__title">
      <span>Une cuisine maison</span>
      <span>qui simplifie</span>
      <span>votre quotidien</span>
    </h1>

    <p class="hero__description">
      Retrouvez le plaisir de bien manger avec des repas préparés directement chez vous, selon vos goûts et votre rythme de vie.
    </p>

    <div class="hero__actions">
      <a href="/formules" class="btn btn--primary">Découvrir les formules</a>
      <a href="/contact" class="btn btn--secondary">Demander un devis</a>
    </div>
  </div>

  <img src={heroArrow.src} alt="" class="hero__arrow" aria-hidden="true" />
</section>