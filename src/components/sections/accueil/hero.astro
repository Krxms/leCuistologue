---
import "../../../styles/sections/accueil/hero.css";

import heroBackground from "../../../assets/accueil/hero/HeroBG.png";
import heroArrow from "../../../assets/accueil/hero/hero-arrow.svg";

import { Image } from "astro:assets";
---

<section class="hero">
  <div class="hero__bg-wrapper">
  <Image src={heroBackground} alt="" class="hero__background" aria-hidden="true" />
</div>

  <div class="hero__content">
    <h1 class="hero__title">
      <span>Une cuisine maison</span>
      <span>qui simplifie</span>
      <span>votre quotidien</span>
    </h1>

    <p class="hero__description">
      Des repas préparés directement chez vous, selon vos goûts et votre rythme de vie, 
      pour retrouver le plaisir de bien manger sans passer vos soirées en cuisine.
    </p>

    <div class="hero__actions">
      <a href="/formules" class="btn btn--primary">Découvrir les formules</a>
      <a href="/contact" class="btn btn--secondary">Demander un devis</a>
    </div>
  </div>

  <img src={heroArrow.src} alt="" class="hero__arrow" aria-hidden="true" />
</section>