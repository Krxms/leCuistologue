---
import "../../../styles/sections/accueil/hero.css";

import heroBackground from "../../../assets/accueil/hero/HeroBG.png";
import heroArrow from "../../../assets/accueil/hero/hero-arrow.svg";
import brocoli from "../../../assets/accueil/hero/brocoli.webp";
// import potato from "../../../assets/accueil/presentation/PdT.svg";  // SVG conservé — perf images, repasser ici si besoin
import potato from "../../../assets/accueil/presentation/PdT.webp";

import { Image } from "astro:assets";
import star from "../../../assets/accueil/commentaires/star.svg";
import type { ResumeAvis } from "../../../lib/googleReviews";
import { getAccueil } from "../../../lib/contenu";

interface Props {
  resume: ResumeAvis;
}
const { resume } = Astro.props;
const noteAffichee = resume.note.toFixed(1).replace(".", ",");
const etoilesPleines = Math.round(resume.note);

// Titre, chapô, boutons et phrase de zone : éditables dans WordPress (page Accueil, voir lib/contenu.ts).
const { hero } = await getAccueil();
// « | » dans la fin du titre = retour à la ligne sur téléphone uniquement.
const titreFin = hero.titreFin.split("|").map((ligne) => ligne.trim());
---

<section class="hero">
  <div class="hero__bg-wrapper">
  <Image
    src={heroBackground}
    alt=""
    class="hero__background"
    aria-hidden="true"
    loading="eager"
    fetchpriority="high"
    widths={[768, 1280, 1920, 2560, 3840]}
    sizes="100vw"
  />
</div>

  <img src={brocoli.src} alt="" class="hero__decor hero__decor--brocoli" aria-hidden="true" />
  <img src={potato.src} alt="" class="hero__decor hero__decor--potato" aria-hidden="true" />

  <div class="hero__content">
    {resume.total > 0 && (
      <p class="hero__eyebrow" aria-label={`Note Google : ${noteAffichee} sur 5, ${resume.total} avis`}>
        <span class="hero__eyebrow-stars" aria-hidden="true">
          {[...Array(5)].map((_, i) => (
            <img
              src={star.src}
              alt=""
              class:list={["hero__eyebrow-star", i >= etoilesPleines && "hero__eyebrow-star--vide"]}
            />
          ))}
        </span>
        <span class="hero__eyebrow-text">
          <strong>{noteAffichee} sur 5</strong> · {resume.total} avis Google
        </span>
      </p>
    )}

    <h1 class="hero__title">
      <span>{hero.titreDebut} <span class="hero__title_colorspan">{hero.titreAccent}</span></span>{" "}
      <span>{titreFin.map((ligne, i) => (<>{i > 0 && <br />}{i > 0 && " "}{ligne}</>))}</span>
      {/* Le <br> n'agit qu'en mobile (masqué dès 768px, voir hero.css). */}
    </h1>

    <p class="hero__description">{hero.description}</p>

    <div class="hero__actions-group">
      <div class="hero__actions">
        <a href="/formules/" class="btn btn--primary">{hero.boutonPrincipal}</a>
        <a href="/contact/" class="btn btn--secondary">{hero.boutonSecondaire}</a>
      </div>

      <p class="hero__zone">{hero.zone}</p>
    </div>

    <img src={heroArrow.src} alt="" class="hero__arrow" aria-hidden="true" />
  </div>
</section>