---
import "../../../styles/sections/a-propos/a-propos-cta.css";
import { Image } from "astro:assets";

import arrow from "../../../assets/a-propos/cta/arrow.svg";
// Même photo que la section Offre de l'accueil et que Une question (Formules)
import photo from "../../../assets/accueil/service/serviceBigPics.png";
---

<section class="a-propos-cta">
  <svg class="a-propos-cta__shape" viewBox="0 0 100 100" preserveAspectRatio="none">
    <defs>
      <linearGradient id="a-propos-cta-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#fbd9db" />
        <stop offset="100%" stop-color="#f8c9d4" />
      </linearGradient>
    </defs>
    <path
      d="M 0,8 Q 50,2 100,0 L 100,100 L 0,100 Z"
      fill="url(#a-propos-cta-gradient)"
    />
  </svg>

  <div class="a-propos-cta__content">
    <h2 class="a-propos-cta__title">
      Prêt à <span class="a-propos-cta__title-accent">simplifier</span> vos semaines ?
    </h2>
    <p class="a-propos-cta__text">
      Ne laissez plus le manque de temps dicter votre alimentation. Découvrez la solution qui vous convient le mieux.
    </p>
    <img src={arrow.src} alt="" class="a-propos-cta__arrow" aria-hidden="true" />
    <div class="a-propos-cta__actions">
      <a href="/formules" class="a-propos-cta__btn a-propos-cta__btn--primary">Je découvre les formules</a>
      <a href="/contact" class="a-propos-cta__btn a-propos-cta__btn--secondary">Contacter le Cuistologue</a>
    </div>
  </div>

  <Image src={photo} alt="Plats préparés par Le Cuistologue" class="a-propos-cta__photo" />
</section>