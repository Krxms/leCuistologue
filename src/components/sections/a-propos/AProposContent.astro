---
import "../../../styles/sections/a-propos/a-propos-content.css";
import { Image } from "astro:assets";

import bgMetier from "../../../assets/a-propos/a-propos-content/bulle-1-metier.svg";
import bgTerre from "../../../assets/a-propos/a-propos-content/bulle-2-terre.svg";
import bgCreativite from "../../../assets/a-propos/a-propos-content/bulle-3-creativite.svg";
import bgSocial from "../../../assets/a-propos/a-propos-content/bulle-4-social.svg";
import bgTransmission from "../../../assets/a-propos/a-propos-content/bulle-5-transmission.svg";
import photo from "../../../assets/a-propos/a-propos-content/Bruno.png";

/* ⚠️ CHANTIER EN COURS — la composition « Voie C » (5 blobs SVG + photo,
   calée sur Group 714.png) est encore en cours d'ajustement en local.
   En attendant, on affiche un placeholder discret sur le site.
   POUR RÉACTIVER : passer EN_CHANTIER à false (ou supprimer le flag et
   le bloc placeholder). Tout le reste — data + composition + CSS — est
   déjà en place. */
const EN_CHANTIER = false;

const bulles = [
  {
    slug: "metier",
    titre: "Le métier",
    bg: bgMetier,
    paras: [
      "Le fait maison est pour moi une manière de pratiquer sérieusement le métier de cuisinier.",
      "Cela passe par la connaissance des produits, la maîtrise des gestes, le respect des cuissons et, surtout, le temps que l'on accepte de consacrer au travail bien fait.",
    ],
    accent:
      "Je défends une cuisine artisanale, simple mais exigeante, où le savoir-faire retrouve toute sa place face à la standardisation.",
  },
  {
    slug: "terre",
    titre: "La terre",
    bg: bgTerre,
    paras: [
      "Mes choix commencent bien avant la cuisine, auprès de celles et ceux qui produisent notre alimentation.",
      "Je privilégie donc les producteurs locaux et porte une attention particulière à l'agriculture paysanne.",
    ],
    accent:
      "C'est une manière pour moi de valoriser les territoires mais aussi de défendre un modèle alimentaire qui donne une place centrale à celles et ceux qui nous nourrissent.",
  },
  {
    slug: "creativite",
    titre: "La créativité",
    bg: bgCreativite,
    paras: [
      "Chaque alimentation est singulière, avec ses goûts, ses habitudes, ses convictions, ses allergies ou ses intolérances.",
      "Ma cuisine s'adapte à chacun sans renoncer au plaisir ni à l'exigence.",
    ],
    accent:
      "Mon rôle n'est pas de vous dire ce que vous devriez manger, mais de mettre mon savoir-faire et ma créativité au service de vos choix.",
  },
  {
    slug: "social",
    titre: "Le lien social",
    bg: bgSocial,
    paras: [
      "Bien manger ne se limite pas à ce qu'il y a dans l'assiette. Cela tient aussi au temps que l'on prend, aux échanges que l'on partage et aux liens que l'on tisse. Cuisiner chez vous est donc un engagement social autant que culinaire.",
    ],
    accent:
      "À l'heure où nos relations se dématérialisent, chaque intervention est aussi l'occasion d'une présence, d'une conversation et d'un moment de convivialité.",
  },
  {
    slug: "transmission",
    titre: "La transmission",
    bg: bgTransmission,
    paras: [
      "Cuisiner, c'est aussi apprendre et transmettre. J'aime partager des gestes, des recettes et des connaissances sur les produits et les saisons, pour éveiller la curiosité et enrichir le rapport de chacun à son alimentation.",
    ],
    accent:
      "À travers mes interventions et mes ateliers, je souhaite ainsi faire vivre et circuler une véritable culture du bien-manger.",
  },
];
---

{EN_CHANTIER ? (
  <section class="a-propos-content a-propos-content--chantier">
    <h2 class="a-propos-content__title">Le goût du lien</h2>
    <p class="a-propos-content__chantier">Section en cours de finalisation</p>
  </section>
) : (
  <section class="a-propos-content">
    <h2 class="a-propos-content__title">Bruno Pereira Vaz</h2>
    <p class="a-propos-content__subtitle">" Le goût du lien "</p>

    <div class="ap-stage">
      {bulles.map((b) => (
        <div class={`ap-bubble ap-bubble--${b.slug}`}>
          <img class="ap-bubble__bg" src={b.bg.src} alt="" aria-hidden="true" />
          <div class="ap-bubble__txt">
            <h3 class="ap-bubble__title">{b.titre}</h3>
            {b.paras.map((p) => (
              <p class="ap-bubble__p">{p}</p>
            ))}
            <p class="ap-bubble__p ap-bubble__p--accent">{b.accent}</p>
          </div>
        </div>
      ))}

      <Image
        class="ap-stage__photo"
        src={photo}
        alt="Bruno Pereira Vaz, le Cuistologue, en pleine préparation dans une cuisine."
        widths={[420, 620, 840]}
        sizes="(max-width: 767px) 60vw, 37vw"
        loading="eager"
      />
    </div>
  </section>
)}
