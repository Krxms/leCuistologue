---
import "../../../styles/sections/a-propos/a-propos-content.css";
import { Image } from "astro:assets";

import bgMetier from "../../../assets/a-propos/a-propos-content/bulle-1-metier.svg";
import bgTerre from "../../../assets/a-propos/a-propos-content/bulle-2-terre.svg";
import bgCreativite from "../../../assets/a-propos/a-propos-content/bulle-3-creativite.svg";
import bgSocial from "../../../assets/a-propos/a-propos-content/bulle-4-social.svg";
import bgTransmission from "../../../assets/a-propos/a-propos-content/bulle-5-transmission.svg";
import photo from "../../../assets/a-propos/a-propos-content/Bruno.webp";

/* EN_CHANTIER = true affiche un placeholder à la place de la composition (blobs + photo). */
const EN_CHANTIER = false;

import { getAPropos } from "../../../lib/contenu";

// Titre, sous-titre et texte des 5 pétales : éditables dans WordPress (voir lib/contenu.ts). Les fonds (bulles) sont fixes.
const contenu = await getAPropos();
const fonds = {
  metier: bgMetier,
  terre: bgTerre,
  creativite: bgCreativite,
  social: bgSocial,
  transmission: bgTransmission,
};
const bulles = contenu.petales.map((p) => ({ ...p, bg: fonds[p.slug] }));
---

{EN_CHANTIER ? (
  <section class="a-propos-content a-propos-content--chantier">
    <h2 class="a-propos-content__title">Le goût du lien</h2>
    <p class="a-propos-content__chantier">Section en cours de finalisation</p>
  </section>
) : (
  <section class="a-propos-content">
    <h2 class="a-propos-content__title">{contenu.titre}</h2>
    <p class="a-propos-content__subtitle">" {contenu.sousTitre} "</p>

    <div class="ap-stage">
      <Image
        class="ap-stage__photo"
        src={photo}
        alt="Bruno Pereira Vaz, le Cuistologue, en pleine préparation dans une cuisine."
        widths={[420, 620, 840]}
        sizes="(max-width: 767px) 60vw, 37vw"
        loading="eager"
      />

      <div class="ap-stage__track" id="ap-stage-track">
        {bulles.map((b) => (
          <div class={`ap-bubble ap-bubble--${b.slug}`}>
            <img class="ap-bubble__bg" src={b.bg.src} alt="" aria-hidden="true" />
            <div class="ap-bubble__txt">
              <h3 class="ap-bubble__title">{b.titre}</h3>
              {b.paras.map((p) => (
                <p class="ap-bubble__p">{p}</p>
              ))}
              <p class="ap-bubble__p ap-bubble__p--accent">{b.accent}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="ap-stage__dots" id="ap-stage-dots">
        {bulles.map((b, i) => (
          <button type="button" class="ap-stage__dot" aria-label={`Aller au pilier « ${b.titre} »`} />
        ))}
      </div>
    </div>
  </section>
)}

<script>
  const track = document.getElementById("ap-stage-track");
  const dotsWrap = document.getElementById("ap-stage-dots");

  if (track && dotsWrap) {
    const cards = Array.from(track.querySelectorAll<HTMLElement>(".ap-bubble"));
    const dots = Array.from(dotsWrap.querySelectorAll<HTMLElement>(".ap-stage__dot"));

    function setActive(i: number) {
      dots.forEach((d, idx) => d.classList.toggle("ap-stage__dot--active", idx === i));
    }

    function scrollToIndex(i: number) {
      cards[i]?.scrollIntoView({ behavior: "smooth", inline: "center", block: "nearest" });
    }

    dots.forEach((d, i) => d.addEventListener("click", () => scrollToIndex(i)));

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && entry.intersectionRatio > 0.6) {
            const idx = cards.indexOf(entry.target as HTMLElement);
            if (idx !== -1) setActive(idx);
          }
        });
      },
      { root: track, threshold: [0.6] }
    );
    cards.forEach((c) => observer.observe(c));

    setActive(0);
  }
</script>
