---
const avis = [
  {
    texte: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt.",
    nom: "Sophie L.",
    role: "Mère de famille, Sagy",
  },
  {
    texte: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt.",
    nom: "Thomas D.",
    role: "Chef d'entreprise, Vigny",
  },
  {
    texte: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt.",
    nom: "Thomas D.",
    role: "Chef d'entreprise, Vigny",
  },
  {
    texte: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt.",
    nom: "Thomas D.",
    role: "Chef d'entreprise, Vigny",
  },
];
---

<section class="bg-cream">
  <div class="mx-auto max-w-7xl px-6 py-20 md:py-28">
    <h2 class="reveal text-center font-display text-2xl font-semibold text-ink md:text-3xl">
      C'est encore eux qui en parlent le <span class="font-accent text-forest-light underline decoration-gold decoration-2 underline-offset-4">mieux</span>
    </h2>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        avis.map((a, i) => (
          <div class="reveal rounded-2xl border border-ink/10 bg-white/50 p-6" style={`transition-delay:${i * 90}ms`}>
            <div class="flex gap-1 text-gold">
              {Array.from({ length: 5 }).map(() => (
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2l2.9 6.3 6.9.6-5.2 4.6 1.6 6.8L12 16.9 5.8 20.3l1.6-6.8L2.2 8.9l6.9-.6L12 2z" />
                </svg>
              ))}
            </div>
            <p class="mt-4 text-sm leading-relaxed text-ink-soft">{a.texte}</p>
            <p class="mt-4 font-display text-sm font-semibold text-ink">{a.nom}</p>
            <p class="text-xs text-ink-soft">{a.role}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
