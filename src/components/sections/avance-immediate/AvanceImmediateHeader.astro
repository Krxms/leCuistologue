---
import "../../../styles/sections/avance-immediate/avance-immediate-header.css";
import { Image } from "astro:assets";

import bg from "../../../assets/avance-immediate/header/bg.svg";
// import broccoli from "../../../assets/avance-immediate/header/brocoli.svg";  // SVG conservé — perf images, repasser ici si besoin
import broccoli from "../../../assets/avance-immediate/header/brocoli.webp";
// import mushroom from "../../../assets/avance-immediate/header/mushroom.svg";  // SVG conservé — perf images, repasser ici si besoin
import mushroom from "../../../assets/avance-immediate/header/mushroom.webp";
// import chicken from "../../../assets/avance-immediate/header/chicken.svg";  // SVG conservé — perf images, repasser ici si besoin
import chicken from "../../../assets/avance-immediate/header/chicken.webp";
// import onion from "../../../assets/avance-immediate/header/onion.svg";  // SVG conservé — perf images, repasser ici si besoin
import onion from "../../../assets/avance-immediate/header/onion.webp";
import arrowConnector from "../../../assets/avance-immediate/header/arrow-connector.svg";
---

<section class="avance-header">
  <img src={bg.src} alt="" class="avance-header__bg" aria-hidden="true" />

  <Image src={broccoli} alt="" class="avance-header__deco avance-header__deco--broccoli" aria-hidden="true" />
  <Image src={mushroom} alt="" class="avance-header__deco avance-header__deco--mushroom" aria-hidden="true" />
  <Image src={chicken} alt="" class="avance-header__deco avance-header__deco--chicken" aria-hidden="true" />
  <Image src={onion} alt="" class="avance-header__deco avance-header__deco--onion" aria-hidden="true" />

  <h1 class="avance-header__title">
    <span class="avance-header__title-line avance-header__title-line--accent">Crédit d'impôt</span>
    <span class="avance-header__title-line">
      <span class="avance-header__title-base">&</span> <span class="avance-header__title-line--accent">avance immédiate<img src={arrowConnector.src} alt="" class="avance-header__arrow" aria-hidden="true" /></span>
    </span>
  </h1>
</section>