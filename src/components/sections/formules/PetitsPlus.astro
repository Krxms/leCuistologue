---
import "../../../styles/sections/formules/petits-plus.css";
import bgCourse from "../../../assets/formules/petits-plus/optionCourse.png";
import bgGourmande from "../../../assets/formules/petits-plus/optionGourmande.png";
import bgPopote from "../../../assets/formules/petits-plus/optionPopote.png";
---

<section class="petits-plus">
  <h2 class="petits-plus__title">
    Les petits <span class="petits-plus__title-accent">plus</span>
  </h2>

  <div class="petits-plus__grid">

    <div class="petits-plus-card petits-plus-card--course">
      <img src={bgCourse.src} alt="" class="petits-plus-card__bg" aria-hidden="true" />
      <div class="petits-plus-content petits-plus-content--course">
        <h3 class="petits-plus-content__title">Courses</h3>
        <p class="petits-plus-content__price">
          12,50 €
          <span class="petits-plus-content__note">(après crédit d'impôt)</span>
        </p>
        <p class="petits-plus-content__description">
          Sélection des produits nécessaires à vos menus auprès des commerces et producteurs adaptés, puis préparation directement dans votre cuisine.
        </p>
      </div>
    </div>

    <div class="petits-plus-card petits-plus-card--popote">
      <img src={bgPopote.src} alt="" class="petits-plus-card__bg" aria-hidden="true" />
      <div class="petits-plus-content petits-plus-content--popote">
        <h3 class="petits-plus-content__title">Popotes à emporter</h3>
        <p class="petits-plus-content__price">
          2,50 €
          <span class="petits-plus-content__note">(après crédit d'impôt)</span>
        </p>
        <p class="petits-plus-content__description">
          Des repas maison prêts à être emportés au travail, à l'école ou ailleurs.
        </p>
      </div>
    </div>

    <div class="petits-plus-card petits-plus-card--gourmande">
      <img src={bgGourmande.src} alt="" class="petits-plus-card__bg" aria-hidden="true" />
      <div class="petits-plus-content petits-plus-content--gourmande">
        <h3 class="petits-plus-content__title">Réserve gourmande</h3>
        <p class="petits-plus-content__price">
          7,50 €
          <span class="petits-plus-content__note">(après crédit d'impôt)</span>
        </p>
        <p class="petits-plus-content__description">
           Quelques préparations maison pour les petites faims ou les goûters.
        </p>
      </div>
    </div>

  </div>
</section>