---
import "../../../styles/sections/formules/petits-plus.css";
import { optionsPetitsPlus } from "../../../lib/formules-data";
import bgCourse from "../../../assets/formules/petits-plus/optionCourse.svg";
import bgPopote from "../../../assets/formules/petits-plus/optionPopote.svg";
import bgGourmande from "../../../assets/formules/petits-plus/optionGourmande.svg";

const fonds = { course: bgCourse, popote: bgPopote, gourmande: bgGourmande };
---

<section class="petits-plus">
  <h2 class="petits-plus__title">
    Les petits <span class="petits-plus__title-accent">plus</span>
  </h2>

  <div class="petits-plus__grid">
    {optionsPetitsPlus.map((opt) => (
      <div class={`petits-plus-card petits-plus-card--${opt.carte}`}>
        <img src={fonds[opt.carte].src} alt="" class="petits-plus-card__bg" aria-hidden="true" />
        <div class={`petits-plus-content petits-plus-content--${opt.carte}`}>
          <h3 class="petits-plus-content__title">{opt.titre}</h3>
          <p class="petits-plus-content__price">
            {opt.prix}
            <span class="petits-plus-content__note">(soit {opt.prixReduit} après crédit d'impôt)</span>
          </p>
          <p
            class="petits-plus-content__description"
            set:html={opt.precision ? `${opt.corps}<br><br><i>${opt.precision}</i>` : opt.corps}
          />
        </div>
      </div>
    ))}
  </div>
</section>
