---
import "../../../styles/sections/formules/pricing-section.css";
import checkmark from "../../../assets/formules/cards/checkmark.svg";
import { formules } from "../../../lib/formules-data";
---

<h2 class="pricing-title">
  Bénéficiez de 50% de crédit d'impôt<br />
  avec avance immédiate
</h2>
<p class="pricing-intro">
  Choisissez votre formule selon votre appétit, vos habitudes et le nombre de repas souhaités
  <br />(le nombre de mangeurs indiqué est simplement un repère).
</p>

<div class="pricing-stage" id="pricing-stage">
  <button type="button" class="pricing-nav pricing-nav--prev" id="pricing-prev" aria-label="Formule précédente">‹</button>

  <section class="pricing" id="pricing-deck">
    {formules.map((formule) => (
      <div class:list={["pricing-card", { "pricing-card--mise-en-avant": formule.misEnAvant }]}>
        <div class="pricing-card__content">
          <h3 class="pricing-card__title">{formule.titre}</h3>

          <p class="pricing-card__portions">{formule.portions}</p>

          <div class="pricing-card__tags">
            <span class="pricing-card__tag">{formule.ideal}</span>
            <span class="pricing-card__tag">{formule.duree}</span>
          </div>

          <div class="pricing-card__features-box">
            <p class="pricing-card__comprend">Comprend :</p>
            <ul class="pricing-card__features">
              {formule.fonctionnalites.slice(0, 3).map((item) => (
                <li>
                  <img src={checkmark.src} alt="" aria-hidden="true" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>

            {formule.fonctionnalites.length > 3 && (
              <details class="pricing-card__features-more">
                <summary>
                  <span class="pricing-card__features-more-label">Voir les {formule.fonctionnalites.length} prestations incluses</span>
                  <span class="pricing-card__features-more-icon" aria-hidden="true"></span>
                </summary>
                <ul class="pricing-card__features">
                  {formule.fonctionnalites.slice(3).map((item) => (
                    <li>
                      <img src={checkmark.src} alt="" aria-hidden="true" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </details>
            )}
          </div>

          <div class="pricing-card__pricing">
            <div class="pricing-card__price-option">
              <p class="pricing-card__price-option-label">Session ponctuelle</p>
              <p class="pricing-card__price-option-full">{formule.ponctuelle.prixPlein} avant crédit d'impôt</p>
              <p class="pricing-card__price-option-reduced">
                {formule.ponctuelle.prixReduit} <span>après crédit d'impôt</span>
              </p>
            </div>

            <div class="pricing-card__price-option pricing-card__price-option--routine">
              <p class="pricing-card__price-option-label">La Routine du Cuistologue</p>
              <p class="pricing-card__price-option-full">{formule.routine.prixPlein} avant crédit d'impôt / session</p>
              <p class="pricing-card__price-option-reduced">
                {formule.routine.prixReduit} <span>après crédit d'impôt</span>
              </p>
              <p class="pricing-card__price-option-note">Abonnement 4 semaines renouvelable et sans engagement.</p>
            </div>
          </div>

          <a href={`/reserver?formule=${formule.slug}`} class="pricing-card__cta">Je me lance</a>
        </div>
      </div>
    ))}
  </section>

  <button type="button" class="pricing-nav pricing-nav--next" id="pricing-next" aria-label="Formule suivante">›</button>

  <div class="pricing-dots" id="pricing-dots"></div>
</div>

<script>
  const mq = window.matchMedia("(min-width: 768px) and (max-width: 1210px)");
  const stage = document.getElementById("pricing-stage") as HTMLElement | null;
  const deck = document.getElementById("pricing-deck") as HTMLElement | null;
  const dotsWrap = document.getElementById("pricing-dots") as HTMLElement | null;
  const btnPrev = document.getElementById("pricing-prev");
  const btnNext = document.getElementById("pricing-next");

  if (stage && deck && dotsWrap) {
    const cards = Array.from(deck.querySelectorAll<HTMLElement>(".pricing-card"));
    const N = cards.length;

    let index = cards.findIndex((c) => c.classList.contains("pricing-card--mise-en-avant"));
    if (index === -1) index = Math.floor(N / 2);

    // Position de chaque carte, en continu (pas recalculée "à zéro" à
    // chaque navigation) : taper/glisser vers la droite fait tourner
    // TOUTES les cartes d'un même cran vers la gauche (et inversement),
    // comme si elles étaient posées sur un cylindre — la carte visée
    // vient bien du côté où elle se trouvait, et aucune carte non
    // concernée ne traverse l'écran pour "raccourcir" un trajet.
    let offsets = cards.map((_, i) => i - index);

    let dragging = false;
    let startX = 0;
    let dragDX = 0;
    let moved = false;
    let actif = false;

    const dots = cards.map((_, i) => {
      const b = document.createElement("button");
      b.className = "pricing-dot";
      b.type = "button";
      b.setAttribute("aria-label", "Aller à la formule " + (i + 1));
      b.addEventListener("click", () => go(i));
      dotsWrap.appendChild(b);
      return b;
    });

    function render(dragShift = 0) {
      // Écartement différent selon la largeur réelle de l'écran :
      // 60 sur l'iPad portrait (< 1024px), 100 au-delà (iPad paysage)
      const largeurEcartement = window.innerWidth < 1024 ? 60 : 100;

      cards.forEach((carte, i) => {
        const off = offsets[i] + dragShift;
        const abs = Math.abs(off);
        const tx = off * largeurEcartement;
        const scale = Math.max(0.86, 1 - abs * 0.1);
        const zi = 100 - Math.round(abs * 10);

        carte.style.transform = `translate(-50%, -50%) translateX(${tx}%) scale(${scale})`;
        carte.style.zIndex = String(zi);
        carte.classList.toggle("pricing-card--stage-active", i === index && dragShift === 0);
      });
      dots.forEach((d, i) => d.classList.toggle("pricing-dot--active", i === index));
    }

    // Décale TOUTES les cartes du même cran (delta), plutôt que de
    // recalculer leur position individuellement — c'est ce qui
    // garantit que la rotation reste cohérente pour l'ensemble.
    function tourner(delta: number) {
      offsets = offsets.map((o) => o - delta);
      render();
    }

    function go(i: number) {
      // Plus court chemin pour amener LA CARTE VISÉE au centre ;
      // les autres suivent avec ce même delta dans tourner().
      let delta = i - index;
      delta -= Math.round(delta / N) * N;
      index = ((i % N) + N) % N;
      tourner(delta);
    }
    const next = () => go(index + 1);
    const prev = () => go(index - 1);

    btnNext?.addEventListener("click", next);
    btnPrev?.addEventListener("click", prev);

    cards.forEach((carte, i) => {
      carte.addEventListener("click", (e) => {
        if (!actif) return;
        if (!moved && i !== index) {
          e.preventDefault();
          go(i);
        }
      });
    });

    const largeurCarte = () => Math.max(200, stage.clientWidth * 0.6);

    function onDown(e: PointerEvent) {
      if (!actif) return;
      dragging = true;
      moved = false;
      startX = e.clientX;
      dragDX = 0;
      cards.forEach((c) => (c.style.transition = "none"));
      deck?.setPointerCapture?.(e.pointerId);
    }
    function onMoveP(e: PointerEvent) {
      if (!dragging) return;
      dragDX = e.clientX - startX;
      if (Math.abs(dragDX) > 6) moved = true;
      // Le signe doit matcher celui du calcul de "shift" dans onUp
      // (Math.round(-dragDX / largeurCarte())) pour que le rendu en
      // direct pendant le glissement se raccorde sans saut à la carte
      // sur laquelle on relâche. Avant : signe inversé ici, donc un
      // swipe droite -> gauche faisait apparaître l'aperçu de la carte
      // de GAUCHE pendant le geste, avant de se corriger d'un coup sur
      // celle de droite au relâchement.
      render(dragDX / largeurCarte());
    }
    function onUp() {
      if (!dragging) return;
      dragging = false;
      cards.forEach((c) => (c.style.transition = ""));
      const shift = Math.round(-dragDX / largeurCarte());
      if (shift !== 0) go(index + shift);
      else render();
    }

    deck.addEventListener("pointerdown", onDown);
    window.addEventListener("pointermove", onMoveP);
    window.addEventListener("pointerup", onUp);
    window.addEventListener("pointercancel", onUp);

    function appliquerEtatEcran(correspond: boolean) {
      actif = correspond;
      if (correspond) {
        render();
      } else {
        cards.forEach((carte) => {
          carte.style.transform = "";
          carte.style.zIndex = "";
        });
      }
    }

    appliquerEtatEcran(mq.matches);
    mq.addEventListener("change", (e) => appliquerEtatEcran(e.matches));

    window.addEventListener("resize", () => {
      if (actif) render();
    });
  }
</script>
