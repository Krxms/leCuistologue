---
import "../../../styles/sections/formules/pricing-section.css";
import checkmark from "../../../assets/formules/cards/checkmark.svg";
import { formules } from "../../../lib/formules-data";
---

<h2 class="pricing-title">
  Bénéficiez de 50% de crédit d'impôt<br />
  avec avance immédiate
</h2>

<section class="pricing">
  {formules.map((formule) => (
    <div class:list={["pricing-card", { "pricing-card--mise-en-avant": formule.misEnAvant }]}>
      <div class="pricing-card__content">
        <h3 class="pricing-card__title">{formule.titre}</h3>

        <p class="pricing-card__accroche">{formule.accroche}</p>

        <p class="pricing-card__ideal">
          <strong>Idéale pour :</strong> {formule.ideal}
        </p>

        <p class="pricing-card__comprend">Comprend</p>
        <ul class="pricing-card__features">
          {formule.fonctionnalites.map((item) => (
            <li>
              <img src={checkmark.src} alt="" aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))}
        </ul>

        <p class="pricing-card__resultat">{formule.resultat}</p>
        <p class="pricing-card__duree">{formule.duree}</p>

        <div class="pricing-card__price-box">
          <p class="pricing-card__price-before">{formule.prixPlein} avant crédit d'impôt</p>
          <p class="pricing-card__price">
            {formule.prixReduit}
            {formule.suffixePrix && <span class="pricing-card__price-suffix">{formule.suffixePrix}</span>}
          </p>
          <span
            class="pricing-card__badge-saving"
            class:list={{ "pricing-card__badge-saving--vide": !formule.mention }}
          >
            {formule.mention || "\u00A0"}
          </span>
        </div>

        <a href={`/reserver?formule=${formule.slug}`} class="pricing-card__cta">Je me lance</a>
      </div>
    </div>
  ))}
</section>