---
import "../../../styles/sections/formules/formules-header.css";
import { Image } from "astro:assets";

import bg from "../../../assets/formules/header/bg.svg";
// import broccoli from "../../../assets/formules/header/brocoli.svg";  // SVG conservé — perf images, repasser ici si besoin
import broccoli from "../../../assets/formules/header/brocoli.webp";
// import mushroom from "../../../assets/formules/header/mushroom.svg";  // SVG conservé — perf images, repasser ici si besoin
import mushroom from "../../../assets/formules/header/mushroom.webp";
// import chicken from "../../../assets/formules/header/chicken.svg";  // SVG conservé — perf images, repasser ici si besoin
import chicken from "../../../assets/formules/header/chicken.webp";
// import onion from "../../../assets/formules/header/onion.svg";  // SVG conservé — perf images, repasser ici si besoin
import onion from "../../../assets/formules/header/onion.webp";
import arrowConnector from "../../../assets/formules/header/arrow-connector.svg";
---

<section class="formules-header">
  <img src={bg.src} alt="" class="formules-header__bg" aria-hidden="true" />

  <Image src={broccoli} alt="" class="formules-header__deco formules-header__deco--broccoli" aria-hidden="true" />
  <Image src={mushroom} alt="" class="formules-header__deco formules-header__deco--mushroom" aria-hidden="true" />
  <Image src={chicken} alt="" class="formules-header__deco formules-header__deco--chicken" aria-hidden="true" />
  <Image src={onion} alt="" class="formules-header__deco formules-header__deco--onion" aria-hidden="true" />

  <h1 class="formules-header__title">
    <span class="formules-header__title-line">
      Des <span class="formules-header__title-accent">formules</span>
    </span>
    <span class="formules-header__title-line">
      adaptées à chaque <span class="formules-header__title-accent">besoin<img src={arrowConnector.src} alt="" class="formules-header__arrow" aria-hidden="true" /></span>
    </span>
  </h1>
</section>