---
import logo from "../assets/navbar/logo.svg";

const navLinks = [
  { label: "Accueil", href: "/" },
  { label: "Comment ça marche ?", href: "/#comment-ca-marche" },
  { label: "Formules", href: "/formules" },
  { label: "À propos", href: "/a-propos" },
  { label: "Avance immédiate", href: "/avance-immediate" },
  { label: "FAQ", href: "/faq" },
];
---

<header class="navbar" id="site-navbar">
  <div class="navbar__brand">
    <img src={logo.src} alt="Le Cuistologue" class="navbar__logo" />
  </div>

  <nav class="navbar__links">
    {
      navLinks.map((link) => (
        <a href={link.href} class="navbar__link">
          {link.label}
        </a>
      ))
    }
  </nav>

  <a href="/contact" class="navbar__cta navbar__cta--bar">Prendre contact</a>

  <button
    class="navbar__burger"
    id="navbar-burger"
    aria-expanded="false"
    aria-controls="navbar-mobile-menu"
    aria-label="Ouvrir le menu"
  >
    <span></span>
    <span></span>
    <span></span>
  </button>

  <div class="navbar__mobile-menu" id="navbar-mobile-menu">
    <nav class="navbar__mobile-links">
      {
        navLinks.map((link) => (
          <a href={link.href} class="navbar__mobile-link">
            {link.label}
          </a>
        ))
      }
    </nav>
    <a href="/contact" class="navbar__cta navbar__cta--menu">Prendre contact</a>
  </div>
</header>