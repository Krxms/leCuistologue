---
import "../styles/global.css";
import "../styles/navbar.css";
import "../styles/cookie-consent.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieConsent from "../components/CookieConsent.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Le Cuistologue — une cuisine maison qui simplifie vraiment votre quotidien.",
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="description" content={description} />
    <title>{title} — Le Cuistologue</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600;700&family=Oswald:wght@500&family=Josefin+Sans:wght@600&family=Jost:wght@400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-cream text-ink">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <CookieConsent />

    <script src="../scripts/global.js"></script>
    <script src="../scripts/navbar.js"></script>
    <script src="../scripts/navbar-menu.js"></script>
  </body>
</html>