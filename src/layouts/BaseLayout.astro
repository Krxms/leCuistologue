---
import "../styles/fonts.css";
import "../styles/global.css";
import "../styles/navbar.css";
import "../styles/cookie-consent.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieConsent from "../components/CookieConsent.astro";
import { site } from "../lib/site-data";

interface Props {
  /** Titre court (nom de la page). Fallback : « <title> — Le Cuistologue ». */
  title: string;
  /** Balise <title> complète, prioritaire sur `title` (pour un titre SEO sur mesure). */
  seoTitle?: string;
  /** Meta description — viser < ~160 caractères, phrase forte en tête. */
  description?: string;
  /** Chemin d'une image de partage (OpenGraph) ; rendue absolue via `site.url`. */
  image?: string;
  /** true → <meta robots noindex> (404, pages sans intérêt de référencement). */
  noindex?: boolean;
  /** Données structurées JSON-LD propres à la page (objet ou tableau d'objets). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  seoTitle,
  description = site.tagline,
  image = site.ogImage,
  noindex = false,
  jsonLd,
} = Astro.props;

const pageTitle = seoTitle ?? `${title} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(image, site.url).href;

/* Schema principal, présent sur toutes les pages : établit l'entité
   locale (nom, adresse, téléphone, zone desservie) auprès de Google. */
const localBusiness = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": `${site.url}/#business`,
  name: site.name,
  legalName: site.legalName,
  url: site.url,
  image: ogImage,
  telephone: site.phone.e164,
  email: site.email,
  priceRange: site.priceRange,
  description:
    "Cuisinier à domicile spécialiste de la cuisine du quotidien. Le Cuistologue prépare vos repas de la semaine directement chez vous, dans le Vexin — Oise, Val-d'Oise, Yvelines et Eure.",
  address: {
    "@type": "PostalAddress",
    streetAddress: site.address.street,
    postalCode: site.address.postalCode,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    addressCountry: site.address.countryCode,
  },
  areaServed: site.areas.map((a) => ({ "@type": "AdministrativeArea", name: a.name })),
  founder: { "@type": "Person", name: site.founder },
  knowsLanguage: "fr-FR",
  ...(site.social.length ? { sameAs: site.social.map((s) => s.url) } : {}),
};

const schemas = [
  localBusiness,
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {site.verification.google && (
      <meta name="google-site-verification" content={site.verification.google} />
    )}
    {site.verification.bing && (
      <meta name="msvalidate.01" content={site.verification.bing} />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link
      rel="preload"
      href="/fonts/inter-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/poppins-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {schemas.map((schema) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body class="bg-cream text-ink">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <CookieConsent />

    <script src="../scripts/global.js"></script>
    <script src="../scripts/navbar.js"></script>
    <script src="../scripts/navbar-menu.js"></script>
  </body>
</html>
