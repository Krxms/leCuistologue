---
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqHeader from "../components/sections/faq/FaqHeader.astro";
import FaqAccordion from "../components/sections/faq/FaqAccordion.astro";
import FaqCta from "../components/sections/faq/FaqCta.astro";
import { getFaq, faqJsonLd } from "../lib/contenu";

const questions = await getFaq();
---

<BaseLayout
  title="Questions fréquentes"
  seoTitle="FAQ — cuisinier à domicile dans le Vexin | Le Cuistologue"
  description="Fonctionnement, zone d'intervention (Oise, Val-d'Oise, Yvelines, Eure), tarifs, crédit d'impôt : les réponses aux questions fréquentes."
  jsonLd={faqJsonLd(questions)}
>
  <FaqHeader />
  <FaqAccordion />
  <FaqCta />
</BaseLayout>
