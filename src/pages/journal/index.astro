---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getJournal } from "../../lib/contenu";
import "../../styles/sections/journal/journal.css";

// Articles : créés et modifiés dans WordPress (Articles), plus ceux restés en Markdown dans le dépôt. Voir lib/contenu.ts.
const posts = await getJournal();

const dateFmt = new Intl.DateTimeFormat("fr-FR", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<BaseLayout
  title="Journal"
  seoTitle="Journal : cuisine du quotidien | Le Cuistologue"
  description="Conseils et coulisses du Cuistologue : organiser ses repas de la semaine, batch cooking, crédit d'impôt, produits de saison dans le Vexin."
  noindex={posts.length === 0}
>
  <section class="journal">
    <div class="journal__inner">
      <h1 class="journal__title">Journal</h1>
      <p class="journal__intro">
        Conseils pratiques et coulisses : organiser sa semaine, cuisiner de saison,
        comprendre le crédit d'impôt.
      </p>

      {posts.length === 0 ? (
        <p class="journal__empty">Les premiers articles arrivent bientôt.</p>
      ) : (
        <ul class="journal__list">
          {posts.map((post) => (
            <li class="journal__item">
              <a href={`/journal/${post.id}/`} class="journal__link">
                <h2 class="journal__item-title">{post.title}</h2>
                <p class="journal__item-desc">{post.description}</p>
                <time class="journal__item-date" datetime={post.date.toISOString()}>
                  {dateFmt.format(post.date)}
                </time>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</BaseLayout>
