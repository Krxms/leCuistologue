---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/reserver.css";
import { formules, optionsPetitsPlus } from "../lib/formules-data";

// `corps` peut contenir <br>/<b>/<i> (utile sur la carte "petits plus") :
// dans l'infobulle on le veut en texte simple.
const texteBrut = (html: string) =>
  html
    .replace(/<br\s*\/?>/gi, " ")
    .replace(/<[^>]+>/g, "")
    .replace(/\s+/g, " ")
    .trim();
---

<BaseLayout
  title="Réserver une formule"
  description="Réservez votre intervention de cuisine à domicile : formule, date, options et informations pour que Le Cuistologue vous recontacte sous 24 h ouvrées."
>
  <section class="reserver">
    <div class="reserver__grid">

      <!-- Les 3 récapitulatifs existent tous, un seul est affiché selon
           le choix fait sur la page Formules (lu côté navigateur, voir
           script plus bas — nécessaire car le site est statique). -->
      <aside class="reserver__recap-wrap">
        {formules.map((formule) => (
          <div class="reserver__recap" data-recap-formule={formule.slug} hidden>
            <p class="reserver__recap-label">Formule sélectionnée</p>
            <h1 class="reserver__recap-title">{formule.titre}</h1>
            <p class="reserver__recap-portions">{formule.portions}</p>

            <p class="reserver__recap-comprend">Comprend</p>
            <ul class="reserver__recap-features">
              {formule.fonctionnalites.map((item) => <li>{item}</li>)}
            </ul>

            <div class="reserver__recap-pricing">
              <div class="reserver__recap-price-option">
                <p class="reserver__recap-price-option-label">Session ponctuelle</p>
                <p class="reserver__recap-price-option-full">{formule.ponctuelle.prixPlein} avant crédit d'impôt</p>
                <p class="reserver__recap-price-option-reduced">
                  {formule.ponctuelle.prixReduit} <span>après crédit d'impôt</span>
                </p>
              </div>

              <div class="reserver__recap-price-option reserver__recap-price-option--routine">
                <p class="reserver__recap-price-option-label">La Routine du Cuistologue</p>
                <p class="reserver__recap-price-option-full">{formule.routine.prixPlein} avant crédit d'impôt / session</p>
                <p class="reserver__recap-price-option-reduced">
                  {formule.routine.prixReduit} <span>après crédit d'impôt</span>
                </p>
                <p class="reserver__recap-price-option-note">Abonnement 4 semaines renouvelable, sans engagement.</p>
              </div>
            </div>

            <a href="/formules" class="reserver__recap-change">← Choisir une autre formule</a>
          </div>
        ))}
      </aside>

      <!-- Colonne droite : formulaire -->
      <div class="reserver__form-wrap">
        <h2 class="reserver__form-title">Vos informations</h2>
        <p class="reserver__form-text">
          Une fois votre demande envoyée, vous recevez un e-mail de confirmation, et Le Cuistologue vous recontacte personnellement sous 24h (jours ouvrés) pour affiner votre besoin.
        </p>

        <!--
          ⚠️ Formulaire visuellement complet et fonctionnel côté affichage,
          mais SANS traitement d'envoi réel pour l'instant.
        -->
        <form class="reserver-form" id="reserver-form">
          <input type="hidden" name="formule" id="input-formule-slug" value="belle-tablee" />

          <div class="reserver-form__row">
            <div class="reserver-form__field">
              <label for="nom">Nom complet</label>
              <input type="text" id="nom" name="nom" required autocomplete="name" />
            </div>
            <div class="reserver-form__field">
              <label for="personnes">Nombre de personnes du foyer</label>
              <input type="number" id="personnes" name="personnes" min="1" max="20" required />
            </div>
          </div>

          <div class="reserver-form__row">
            <div class="reserver-form__field">
              <label for="email">Adresse e-mail</label>
              <input type="email" id="email" name="email" required autocomplete="email" />
            </div>
            <div class="reserver-form__field">
              <label for="date-souhaitee">Date souhaitée pour la 1ère intervention</label>
              <input type="date" id="date-souhaitee" name="date-souhaitee" required />
            </div>
          </div>

          <fieldset class="reserver-form__preference">
            <legend>Comment préférez-vous que je vous réponde ?</legend>
            <div class="reserver-form__radio-group">
              <label class="reserver-form__radio">
                <input type="radio" name="preference" value="email" checked />
                Par e-mail
              </label>
              <label class="reserver-form__radio">
                <input type="radio" name="preference" value="telephone" />
                Par téléphone
              </label>
            </div>
          </fieldset>

          <div class="reserver-form__field reserver-form__field--telephone" id="champ-telephone" hidden>
            <label for="telephone">Numéro de téléphone</label>
            <input type="tel" id="telephone" name="telephone" autocomplete="tel" />
          </div>

          <div class="reserver-form__field">
            <label for="commune">Commune / zone d'intervention</label>
            <input type="text" id="commune" name="commune" required placeholder="Ex : Serans (60)" />
            <p class="reserver-form__hint">
              Zone d'intervention habituelle : Yvelines (78), Val-d'Oise (95), Oise (60), Eure (27). Hors de cette zone ? Indiquez votre commune, nous verrons ensemble si une intervention est possible.
            </p>
          </div>

          <fieldset class="reserver-form__preference">
            <legend>Allergies ou intolérances alimentaires ?</legend>
            <div class="reserver-form__radio-group">
              <label class="reserver-form__radio">
                <input type="radio" name="allergies" value="non" checked />
                Non
              </label>
              <label class="reserver-form__radio">
                <input type="radio" name="allergies" value="oui" />
                Oui
              </label>
            </div>
          </fieldset>

          <div class="reserver-form__field reserver-form__field--allergies" id="champ-allergies" hidden>
            <label for="allergies-details">Précisez lesquelles</label>
            <textarea id="allergies-details" name="allergies-details" rows="2"></textarea>
          </div>

          <fieldset class="reserver-form__preference">
            <legend>Souhaitez-vous ajouter des options ? (facultatif)</legend>
            <div class="reserver-form__checkbox-group">
              {optionsPetitsPlus.map((opt) => (
                <div class="reserver-form__checkbox-row">
                  <label class="reserver-form__checkbox">
                    <input type="checkbox" name="options" value={opt.slug} />
                    {opt.labelFormulaire}
                  </label>
                  <button type="button" class="reserver-form__info" data-info-target={`info-${opt.slug}`} aria-expanded="false" aria-label={`Détails de l'option ${opt.labelFormulaire}`}>i</button>
                  <span class="reserver-form__tooltip" id={`info-${opt.slug}`} role="tooltip" hidden>
                    <span class="reserver-form__tooltip-price">
                      {opt.prix} <span>· {opt.prixReduit} après crédit d'impôt</span>
                    </span>
                    {texteBrut(opt.corps)}
                    {opt.precision && <em class="reserver-form__tooltip-note">{opt.precision}</em>}
                  </span>
                </div>
              ))}
            </div>
          </fieldset>

          <div class="reserver-form__field">
            <label for="message">Précisions complémentaires (facultatif)</label>
            <textarea id="message" name="message" rows="4"></textarea>
          </div>

          <button type="submit" class="reserver-form__submit">Envoyer ma demande</button>

          <p class="reserver-form__status" id="reserver-form-status" role="status" aria-live="polite"></p>
        </form>
      </div>

    </div>
  </section>
</BaseLayout>

<script>
  // Infobulles des options : au survol/focus, le CSS suffit (:hover/:focus-visible).
  // Au tap tactile, il n'y a ni survol ni fermeture naturelle : on bascule donc
  // l'affichage au clic, et on referme au clic ailleurs sur la page.
  const boutonsInfo = document.querySelectorAll<HTMLButtonElement>(".reserver-form__info");

  function fermerToutesLesInfobulles(sauf?: HTMLButtonElement) {
    boutonsInfo.forEach((bouton) => {
      if (bouton === sauf) return;
      bouton.setAttribute("aria-expanded", "false");
      const cible = document.getElementById(bouton.dataset.infoTarget || "");
      cible?.setAttribute("hidden", "");
    });
  }

  boutonsInfo.forEach((bouton) => {
    bouton.addEventListener("click", (e) => {
      e.stopPropagation();
      const cible = document.getElementById(bouton.dataset.infoTarget || "");
      const estOuverte = bouton.getAttribute("aria-expanded") === "true";
      fermerToutesLesInfobulles(bouton);
      bouton.setAttribute("aria-expanded", estOuverte ? "false" : "true");
      if (estOuverte) cible?.setAttribute("hidden", "");
      else cible?.removeAttribute("hidden");
    });
  });

  document.addEventListener("click", () => fermerToutesLesInfobulles());

  const inputDate = document.getElementById("date-souhaitee") as HTMLInputElement;
  if (inputDate) {
    inputDate.min = new Date().toISOString().split("T")[0];
  }

  const params = new URLSearchParams(window.location.search);
  const slugChoisi = params.get("formule") || "belle-tablee";

  const recaps = document.querySelectorAll<HTMLElement>("[data-recap-formule]");
  let slugValide = "belle-tablee";

  recaps.forEach((recap) => {
    const estLeBon = recap.dataset.recapFormule === slugChoisi;
    recap.hidden = !estLeBon;
    if (estLeBon) slugValide = slugChoisi;
  });

  if (![...recaps].some((r) => r.dataset.recapFormule === slugChoisi)) {
    const premier = recaps[0];
    if (premier) {
      premier.hidden = false;
      slugValide = premier.dataset.recapFormule || "belle-tablee";
    }
  }

  const inputFormuleSlug = document.getElementById("input-formule-slug") as HTMLInputElement;
  if (inputFormuleSlug) {
    inputFormuleSlug.value = slugValide;
  }

  const radiosPreference = document.querySelectorAll('input[name="preference"]');
  const champTelephone = document.getElementById("champ-telephone");
  const inputTelephone = document.getElementById("telephone") as HTMLInputElement;

  function majTelephone() {
    const veutTelephone = document.querySelector<HTMLInputElement>(
      'input[name="preference"]:checked'
    )?.value === "telephone";
    champTelephone?.toggleAttribute("hidden", !veutTelephone);
    if (inputTelephone) inputTelephone.required = veutTelephone;
  }
  radiosPreference.forEach((r) => r.addEventListener("change", majTelephone));
  majTelephone();

  const radiosAllergies = document.querySelectorAll('input[name="allergies"]');
  const champAllergies = document.getElementById("champ-allergies");

  function majAllergies() {
    const aDesAllergies = document.querySelector<HTMLInputElement>(
      'input[name="allergies"]:checked'
    )?.value === "oui";
    champAllergies?.toggleAttribute("hidden", !aDesAllergies);
  }
  radiosAllergies.forEach((r) => r.addEventListener("change", majAllergies));
  majAllergies();

  const form = document.getElementById("reserver-form") as HTMLFormElement;
  const statusEl = document.getElementById("reserver-form-status");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const boutonEnvoyer = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    boutonEnvoyer.disabled = true;
    if (statusEl) statusEl.textContent = "Envoi en cours...";

    const formData = new FormData(form);
    const formuleActuelle = document.querySelector<HTMLElement>("[data-recap-formule]:not([hidden])");

    const data = {
      type: "reservation",
      formule: formData.get("formule"),
      formuleTitre: formuleActuelle?.querySelector(".reserver__recap-title")?.textContent || "",
      nom: formData.get("nom"),
      email: formData.get("email"),
      telephone: formData.get("telephone"),
      preference: formData.get("preference"),
      personnes: formData.get("personnes"),
      dateSouhaitee: formData.get("date-souhaitee"),
      commune: formData.get("commune"),
      options: formData.getAll("options"),
      allergies: formData.get("allergies"),
      allergiesDetails: formData.get("allergies-details"),
      message: formData.get("message"),
    };

    try {
      const res = await fetch("/api/send", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });
      const resultat = await res.json() as { ok: boolean; erreur?: string };

      if (resultat.ok) {
        if (statusEl) statusEl.textContent = "Votre demande a bien été envoyée. Vous recevrez une confirmation par e-mail.";
        form.reset();
      } else {
        if (statusEl) statusEl.textContent = "Une erreur est survenue. Réessayez ou contactez-nous directement par téléphone.";
        boutonEnvoyer.disabled = false;
      }
    } catch {
      if (statusEl) statusEl.textContent = "Une erreur réseau est survenue. Réessayez.";
      boutonEnvoyer.disabled = false;
    }
  });
</script>