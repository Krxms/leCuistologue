---
import BaseLayout from "../layouts/BaseLayout.astro";
import CuisinierOiseContent from "../components/sections/cuisinier-a-domicile-oise/CuisinierOiseContent.astro";
import { site } from "../lib/site-data";

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Accueil", item: `${site.url}/` },
    {
      "@type": "ListItem",
      position: 2,
      name: "Cuisinier à domicile dans le Vexin",
      item: `${site.url}/cuisinier-a-domicile-oise`,
    },
  ],
};
---

<BaseLayout
  title="Cuisinier à domicile dans l'Oise"
  seoTitle="Cuisinier à domicile dans le Vexin et ses alentours | Le Cuistologue"
  description="Le Cuistologue, cuisinier à domicile à Serans et dans tout le Vexin : préparation de repas maison chez vous, dans l'Oise, le Val-d'Oise, les Yvelines et l'Eure."
  jsonLd={breadcrumb}
>
  <CuisinierOiseContent />
</BaseLayout>
